# Get this from https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_client_id_here

# Must match exactly what you set in your Spotify app's Redirect URIs
# For GitHub Pages: https://YOUR_USERNAME.github.io/spotpop/
# For local dev:    http://localhost:5173/
VITE_REDIRECT_URI=http://localhost:5173/

# Set to /spotpop/ for GitHub Pages deployment (must match repo name)
VITE_BASE_URL=/
